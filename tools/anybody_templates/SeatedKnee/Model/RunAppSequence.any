/** Execute this operation to run the whole MVIC analysis:
 1. muscle calibration (empty for the simple muscle model)
 2. kinematics: places the model in the posture
 3. maximum strap force by two inverse dynamics runs (see EvaluateMaxLoad)
The result is printed in the Output window and stored in Main.MaxLoading.MaxLoad. */
AnyOperationSequence RunApplication =
{
  AnyOperation &CalibrationAnal = Main.HumanModel.Calibration.CalibrationSequence;

  AnyOperation &Posture = Main.Study.Kinematics;

  AnyOperation &MaxForce = Main.MaxLoading.Evaluate;
};

// Set the strap load: the measured force of the trial, or the probe load that MaxLoading starts from.
// tools/anybody_models_run.py runs the study at the measured force first (for the read-backs), then at the probe load for MaxLoading.
// (Same mechanism as the AnyOperationSetValue objects inside the AMMR tool EvaluateMaxLoad.)
AnyFolder Ops =
{
  AnyOperationSetValue UseMeasuredForce =
  {
    Source = {&Main.Position.MeasuredForce_N};
    Target = {&Main.Model.ModelEnvironmentConnection.StrapLoad.Magnitude};
  };

  AnyOperationSetValue UseProbeLoad =
  {
    Source = {&Main.Position.ProbeLoad_N};
    Target = {&Main.Model.ModelEnvironmentConnection.StrapLoad.Magnitude};
  };
};
