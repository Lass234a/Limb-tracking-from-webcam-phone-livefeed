#include "libdef.any"

/* ---------------------------------------------------------------------------------------
Seated knee MVIC (knee extension, and knee flexion with the strap on the other side): the shared model of the limbtrack position models.

This is the group's SeatedKneeExtMVIC model (AMMR 3.2.1, AnyBody 8.2) made general: the subject, the angles, the force and the side that is
tested come from two small files that tools/anybody_models.py writes next to the opening Main.any:
    <PARTICIPANT_DIR>/Participant.any   height, mass, fat percent (and, only if asked for, thigh and shank length)
    <POSITION_DIR>/Position.any         tested leg, joint angles, force, direction of the force, strap place
Edit Position.any to adjust a position. Do not type numbers into this file.

Two versions of every position are written: Main.any (hip held ideally by the pelvic belt and thigh strap) and Main_HipFree.any (the hip
muscles hold the hip). The truth is between them. See references/first-run-checklist.md of the skill anybody-position-models.

How to run: load Main.any, run Main.RunApplication. Main.MaxLoading.MaxLoad is the model's strap force at 100 % muscle activity.
--------------------------------------------------------------------------------------- */

// Tool for computing the maximum load; must be included before Main
#include "<ANYBODY_PATH_MODELUTILS>/Validation/EvaluateMaxExternalLoad.any"

Main =
{
  // Which leg is tested and which leg has muscles (the other is held by joint actuators); written per position
  #include "<POSITION_DIR>/Position.any"

  #ifndef WITH_CHECKS
  #define WITH_CHECKS 0
  #endif

  // BodyModel configuration: leg model, hard drivers, scaling law
  #include "Model/BodyModelConfiguration.any"

  // The person: Main.HumanModel.Anthropometrics, read by the AMMR defaults (??=) when the human model loads
  #include "<PARTICIPANT_DIR>/Participant.any"

  // Include the Human model from AMMR
  #include "<ANYBODY_PATH_BODY>/HumanModel.any"

  // Seated posture
  #include "Model/Mannequin.any"

  // Links to the tested leg
  #include "Model/TestedLeg.any"

  // Compose the model used by the study
  AnyFolder Model =
  {
    AnyFolder &BodyModel = .HumanModel.BodyModel;
    AnyFolder &DefaultMannequinDrivers = .HumanModel.DefaultMannequinDrivers;

    #include "Model/Environment.any"

    AnyFolder ModelEnvironmentConnection =
    {
      // Supports (every driver but the tested knee carries reaction forces) and the load-cell strap
      #include "Model/JointsAndDrivers.any"
    };
  };

  // Static inverse dynamics, one step
  AnyBodyStudy Study =
  {
    AnyFolder &Model = .Model;

    Gravity = {0.0, -9.81, 0.0};
    tEnd = 1;
    nStep = 1;

    // Maximum voluntary effort: min-max recruitment (required by EvaluateMaxLoad)
    InverseDynamics.Criterion.Type = MR_MinMaxStrict;
  };

  // Optional read-backs for the first run (switch: WITH_CHECKS in Position.any)
  #if WITH_CHECKS == 1
  #include "Model/Checks.any"
  #endif

  // Maximum strap force: two inverse dynamics runs at different loads, extrapolated to MaxMuscleActivity = 1
  EvaluateMaxLoad MaxLoading(STUDY = Main.Study) =
  {
    LoadPtr = &Main.Model.ModelEnvironmentConnection.StrapLoad.Magnitude;
  };

  #include "Model/RunAppSequence.any"

}; // Main
