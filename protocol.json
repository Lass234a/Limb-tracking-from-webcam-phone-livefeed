{
  "_note": "EDIT ME. Landmarks and arms follow Tabel 3 (goniometer alignment), sagittal view of the tested side. Target angles come from ChenData/StrengthCurve/plot_proposal.m. An angle is the angle between two 'arms'. An arm is [dotA, dotB] (vector from A to B), {\"perp\": [dotA, dotB]} (perpendicular to A-B, pointing towards the feet), or \"up\" / \"down\" / \"forward\". Shown value = sign * angle + offset. 'signed' angles can be negative (extension, posterior tilt); their sign assumes the participant faces RIGHT, and the app mirrors automatically when you choose 'faces left'.",
  "tolerance_deg": 3.0,
  "neighbour_tolerance_deg": 5.0,

  "dot_order": ["asis", "psis", "trochanter", "epicondyle", "fibular_head", "malleolus", "mt5_base", "mt5_head"],
  "dot_labels": {
    "asis": "ASIS (front of pelvis)",
    "psis": "PSIS (back of pelvis)",
    "trochanter": "greater trochanter",
    "epicondyle": "lateral femoral epicondyle",
    "fibular_head": "fibular head",
    "malleolus": "lateral malleolus",
    "mt5_base": "5th metatarsal base",
    "mt5_head": "5th metatarsal head"
  },

  "angle_library": {
    "hip": {
      "label": "Hip flex (+) / ext (-)",
      "vectors": [{"perp": ["asis", "psis"]}, ["trochanter", "epicondyle"]],
      "signed": true, "sign": -1, "offset": 0, "fulcrum": "trochanter"
    },
    "knee": {
      "label": "Knee flexion",
      "vectors": [["trochanter", "epicondyle"], ["fibular_head", "malleolus"]],
      "fulcrum": "epicondyle"
    },
    "ankle": {
      "label": "Ankle dorsiflex (+)",
      "vectors": [["malleolus", "fibular_head"], ["mt5_base", "mt5_head"]],
      "sign": -1, "offset": 90, "fulcrum": "malleolus"
    },
    "pelvic_tilt": {
      "label": "Pelvic tilt (ant +)",
      "vectors": ["forward", ["psis", "asis"]],
      "signed": true, "fulcrum": "asis"
    }
  },

  "tests": {
    "knee_extension": {
      "label": "Knee extension (MVIC)",
      "primary": "knee",
      "targets": [20, 65, 110],
      "angles": ["knee", "hip", "ankle", "pelvic_tilt"]
    },
    "knee_flexion": {
      "label": "Knee flexion (MVIC)",
      "primary": "knee",
      "targets": [15, 50, 85],
      "angles": ["knee", "hip", "ankle", "pelvic_tilt"]
    },
    "hip_extension": {
      "label": "Hip extension (MVIC)",
      "primary": "hip",
      "targets": [0, 45, 90],
      "angles": ["hip", "knee", "ankle", "pelvic_tilt"]
    },
    "hip_flexion": {
      "label": "Hip flexion (MVIC)",
      "primary": "hip",
      "targets": [0, 45],
      "angles": ["hip", "knee", "ankle", "pelvic_tilt"]
    },
    "ankle_plantarflexion": {
      "label": "Ankle plantarflexion (MVIC)",
      "primary": "ankle",
      "targets": [-20, 0, 20],
      "angles": ["ankle", "knee", "hip", "pelvic_tilt"]
    },
    "ankle_dorsiflexion": {
      "label": "Ankle dorsiflexion (MVIC)",
      "primary": "ankle",
      "targets": [-10, 10],
      "angles": ["ankle", "knee", "hip", "pelvic_tilt"]
    },
    "belt_squat": {
      "label": "Belt squat (MVIC)",
      "primary": "knee",
      "targets": [],
      "angles": ["knee", "hip", "ankle", "pelvic_tilt"]
    }
  }
}
